# =============================================================================
# TwoPunctures geodesic probe, FAR variant: tp_far_r10_025_t030_i015
# Same TwoPunctures GW150914 background, grid and sampler as
# tp_l27r_025.par (local27, 144^3, dx=0.25, no AMR).
# IC: ring r=10, 100 particles, prograde tangential velocity 0.30 (slightly sub-circular)
#   tp_l27r_025.par (u^phi-mag = 0.862628931582761), inward radial
#   velocity HALVED (0.479820887789410 = 0.959641775578820/2).
#   u^t given as 1.774115229207234; the thorn re-solves u^0 from the
#   normalization condition at init (spatial parts kept).
# Purpose: far-from-BH probe run for the paper Sec. 5.6 rewrite.
#   Not part of the automatic validation (test/): long run time and
#   large data variability make automated checks impractical.
# Run 4p*20t: itlast=200 (t=0..20), dump every 10 steps (20 fires).
# =============================================================================
Cactus::cctk_run_title = "tp_far_r10_025_t030_i015"
Cactus::cctk_full_warnings = "yes"
Cactus::terminate             = "iteration"
Cactus::cctk_itlast           =  200
Time::timestep_method         = "given"
Time::timestep                =  0.1
ActiveThorns = "Boundary CartGrid3D CoordBase InitBase SymBase Time"
ActiveThorns = "Carpet CarpetLib CarpetReduce"
ActiveThorns = "IOUtil"
ActiveThorns = "ADMBase ADMcoupling ADMmacros CoordGauge StaticConformal TwoPunctures"
ActiveThorns = "Geodesic"
Carpet::output_initialise_timer_tree = "no"
Carpet::storage_verbose = "no"
Carpet::verbose = "no"
Carpet::veryverbose = "no"
Driver::ghost_size            = 4
