#------------------------------------------------------------------------------
# Geodesic AMR interpolation comparison (local27)
#
# Identical to par/conv100.par (KerrSchild M = 2, a = 0.5, Exact = no,
# one particle on the prograde equatorial circular orbit r_KS = 10,
# t to 150.1) except for the grid and the interpolation method:
#
#   1. the grid is AMR: a 50^3 base grid (dx = 1, domain +-25) plus two
#      static spherical CarpetRegrid2 refinement levels centred on the
#      origin: level 1 box +-16 (dx = 0.5), level 2 box +-8 (dx = 0.25).
#      The particle orbit (r_KS = 10) lives on level 1 -- the same local
#      resolution as conv100's uniform 100^3 grid (dx = 0.5).
#   2. Geodesic::metric_interp = "local27" selects the spatial metric /
#      Christoffel sampler.  The three files (carpet / aei / l27) differ
#      ONLY in that setting; compare all of them against par/conv100.par.
#
# Driver level-mode subcycling: each coarse step (dt = 0.1) consists of
# 4 finest-level steps (L0 x1, L1 x2, L2 x4), and cctk_iteration counts
# finest-level steps.  The particle is integrated once per coarse step
# (at the L0 boundary), so to reach the same final time as conv100
# (t_final = 150.1 after 1501 coarse steps):
#   cctk_itlast         = 6004 finest substeps = 4 x 1501 = 1501 coarse steps
#   particle_dump_every = 4 finest substeps = one coarse step: the state is
#       dumped at every coarse step (t = 0.1, 0.2, ..., 150.1), a superset
#       of conv100's dump times (t = 0.1, 10.1, ..., 150.1) for a direct
#       line-by-line comparison.
#------------------------------------------------------------------------------
Cactus::cctk_run_title = "Geodesic AMR interpolation comparison (local27)"
Cactus::cctk_full_warnings         = "yes"

Cactus::terminate        = "iteration"
Cactus::cctk_itlast      =  6004  # finest-level substeps: 4 per coarse step (driver level-mode subcycling) = 1501 coarse steps, t_final = 150.1 as in conv100
Time::timestep_method    = "given"
Time::timestep           =  0.1

#------------------------------------------------------------------------------
# Activate all necessary thorns:
#------------------------------------------------------------------------------

ActiveThorns = "Boundary CartGrid3D CoordBase Fortran InitBase LocalReduce SymBase Time"
ActiveThorns = "AEILocalInterp LocalInterp"
ActiveThorns = "MoL Periodic Slab SpaceMask"
ActiveThorns = "Carpet CarpetInterp CarpetIOASCII CarpetIOHDF5 CarpetIOScalar CarpetLib CarpetIOBasic CarpetReduce CarpetRegrid2 CarpetSlab LoopControl"
ActiveThorns = "IOUtil Formaline"
ActiveThorns = "NaNChecker TerminationTrigger TimerReport"
ActiveThorns = "ADMbase ADMcoupling ADMmacros CoordGauge StaticConformal"
ActiveThorns = "Constants TmunuBase HydroBase KerrSchild SPHERICALSURFACE Minkowski"
ActiveThorns = "EOS_Omni"
ActiveThorns = "HDF5"
ActiveThorns = "SystemStatistics  Geodesic"

#------------------------------------------------------------------------------
# Diagnostic parameters:
#------------------------------------------------------------------------------

Carpet::output_timers_every = 1024
Carpet::output_timer_tree_every = 256
Carpet::output_initialise_timer_tree = "yes"
Carpet::storage_verbose   = "no"
Carpet::verbose           = "no"
Carpet::veryverbose       = "no"

CarpetLib::output_bboxes  = "no"
CarpetLib::print_memstats_every     = 1024
CarpetLib::memstat_file    = "carpetlib-memory-statistics.asc"

CarpetReduce::verbose    = "no"

TimerReport::out_every    = 1024
TimerReport::out_filename = "TimerReport"
TimerReport::n_top_timers = 40

#------------------------------------------------------------------------------
# Utility parameters:
#------------------------------------------------------------------------------

NaNChecker::check_every   =  64
NaNChecker::check_vars = "
            HydroBase::rho 
            HydroBase::eps 
            HydroBase::press 
            HydroBase::vel
"
NaNChecker::action_if_found = "just warn"

TerminationTrigger::max_walltime          =  24.0   # hours
TerminationTrigger::on_remaining_walltime = 10.0   # minutes
TerminationTrigger::termination_from_file   = "yes"
TerminationTrigger::create_termination_file = "yes"
TerminationTrigger::termination_file        = "../TERMINATE"

#------------------------------------------------------------------------------
# Run parameters:
#------------------------------------------------------------------------------

#------
# Grid:
#------

Time::dtfac = 0.125
MoL::ODE_Method             = "rk4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CoordBase::domainsize       = "minmax"
CoordBase::spacing          = "numcells"

CoordBase::xmin =  -25.0
CoordBase::ymin =  -25.0
CoordBase::zmin =  -25.0
CoordBase::xmax =   25.0
CoordBase::ymax =   25.0
CoordBase::zmax =   25.0
CoordBase::ncells_x   = 50
CoordBase::ncells_y   = 50
CoordBase::ncells_z   = 50

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_shiftout_z_lower    = 0
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0
CoordBase::boundary_staggered_x_lower   = "yes"
CoordBase::boundary_staggered_y_lower   = "yes"
CoordBase::boundary_staggered_z_lower   = "yes"
CoordBase::boundary_staggered_x_upper   = "yes"
CoordBase::boundary_staggered_y_upper   = "yes"
CoordBase::boundary_staggered_z_upper   = "yes"

Driver::ghost_size                      = 4

Periodic::periodic = "no"
Periodic::periodic_x = "no"
Periodic::periodic_y = "no"
Periodic::periodic_z = "no"

# General Carpet parameters:
Carpet::domain_from_coordbase        = "yes"
Carpet::enable_all_storage           = "no"
Carpet::schedule_barriers            = "no"
#------
# AMR grid (the grid difference vs conv100.par): two static spherical
# refinement levels centred on the origin (CarpetRegrid2).  The particle
# orbit r_KS = 10 lies inside the level-1 safe region, so it is sampled
# on the dx = 0.5 grid -- the same local resolution as conv100's uniform
# 100^3 grid.
Carpet::max_refinement_levels        = 3
Carpet::refinement_factor            = 2
Carpet::refinement_centering         = "cell"
# fill the past time levels of the refined levels with the current
# (static) values so the Geodesic thorn's stationary-metric detection
# engages and dt(g) = 0 exactly
Carpet::init_fill_timelevels         = "yes"

CarpetRegrid2::verbose               = "no"
CarpetRegrid2::num_centres           = 1
CarpetRegrid2::active_1              = "yes"
# num_levels_1 is one larger than the highest refinement level
# (CarpetRegrid2 radius arrays are 1-based and index 0 is unused)
CarpetRegrid2::num_levels_1          = 3
CarpetRegrid2::position_x_1          = 0.0
CarpetRegrid2::position_y_1          = 0.0
CarpetRegrid2::position_z_1          = 0.0
# radius_1[k] = half-width of the level-k box:
# level 1 (dx = 0.5) is the outer box, level 2 (dx = 0.25) the inner
CarpetRegrid2::radius_1[1]           = 16.0
CarpetRegrid2::radius_1[2]           = 8.0


ADMBase::lapse_timelevels  = 3
ADMBase::shift_timelevels  = 3
ADMBase::metric_timelevels = 3

CarpetLib::poison_new_memory         = "no"
CarpetLib::poison_value              = 114
CarpetLib::check_bboxes              = "no"
CarpetLib::interleave_communications = "yes"
CarpetLib::combine_sends             = "yes"

CarpetInterp::tree_search = "yes"
CarpetInterp::check_tree_search = "no"

#------
# MODEL:
#------

ADMBase::initial_data                = "KerrSchild"
ADMBase::initial_lapse               = "KerrSchild"
ADMBase::initial_shift               = "KerrSchild"
ADMBase::initial_dtlapse             = "KerrSchild"
ADMBase::initial_dtshift             = "KerrSchild"

#----------
# Numerics:
#----------

TmunuBase::stress_energy_storage = "yes"
TmunuBase::stress_energy_at_RHS  = "yes"
TmunuBase::timelevels            =  1
TmunuBase::prolongation_type     = "none"

HydroBase::timelevels            = 3

SpaceMask::use_mask      = "yes"

#-----------
# Evolution:
#-----------

KerrSchild::M = 2.0
KerrSchild::a = 0.50

# Exact=yes mode uses the thorn's own M/a; must match KerrSchild::M/a above
Geodesic::M = 2.0
Geodesic::a = 0.50

Geodesic::excised_radius         = 8
Geodesic::initial_radius         = 35.0
Geodesic::particle_rand_xmin     = -35.5
Geodesic::particle_rand_xmax     = 35.5
Geodesic::particle_rand_ymin     = -35.5
Geodesic::particle_rand_ymax     = 35.5
Geodesic::particle_rand_zmin     = -35.0
Geodesic::particle_rand_zmax     = 35.0
Geodesic::particle_middle_sp     = 0.0

# AMR: the particle stencil is drawn from the finest level that contains
# the particle (must equal Carpet::max_refinement_levels for an AMR run)
Geodesic::geodesic_amr_levels        = 3
# spatial metric / Christoffel sampler: carpet / aei / local27 -- the
# only science setting that differs between the three comparison files
Geodesic::metric_interp              = "local27"
Geodesic::Exact                  = "no"
Geodesic::rverbose               = "yes"
Geodesic::particle_dump_every   = 4  # finest-level substeps; 4 = one coarse step, so the state is dumped at t = 0.1, 0.2, ..., 150.1 (a superset of conv100's dump times, for a direct line-by-line comparison)
Geodesic::step                   = 0.0
Geodesic::particle_n_total       = 1
Geodesic::particle_n             = 1

Geodesic::particle_x[0]          = 10
Geodesic::particle_y[0]          = 0.0
Geodesic::particle_z[0]          = 0.0
Geodesic::particle_tv[0] = 1.534278146349868
Geodesic::particle_xv[0] = 0
Geodesic::particle_yv[0] = 0.6723763507576922
Geodesic::particle_zv[0] = 0

#------------------------------------------------------------------------------
# Output:
#------------------------------------------------------------------------------

IO::out_dir = $parfile

IOBasic::outInfo_every = 4
IOBasic::outInfo_vars  = "
 Carpet::physical_time_per_hour
 HydroBase::press
 HydroBase::rho
 HydroBase::vel
"

IOScalar::outScalar_every      = 102400
IOScalar::one_file_per_group   = "yes"
IOScalar::outScalar_reductions = "minimum maximum average norm1 norm2"

CarpetIOHDF5::one_file_per_group             = "yes"
CarpetIOHDF5::open_one_input_file_at_a_time  = "yes"

CarpetIOHDF5::output_symmetry_points         = "yes"
CarpetIOHDF5::output_ghost_points            = "yes"
CarpetIOHDF5::output_boundary_points         = "yes"
CarpetIOHDF5::output_buffer_points           = "yes"

#------------------------------------------------------------------------------
# Checkpoint/Recovery:
#------------------------------------------------------------------------------
IOHDF5::checkpoint                  = "no"
IO::checkpoint_dir                  = $parfile
IO::checkpoint_on_terminate         = "no"
