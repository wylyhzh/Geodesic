#------------------------------------------------------------------------------
# Example parameter file for the Geodesic thorn:
# Kerr--Schild metric M = 2, a = 0.5 on a 50^3 Cartesian grid, one particle
# on a prograde equatorial circular orbit, Exact = yes.
#
#   cd <cactus> && ./simfactory/bin/sim run --parfile .../Geodesic/par/example.par
#
# The particle state is dumped to geodesic_particles.txt every iteration
# (particle_dump_every = 1).
#------------------------------------------------------------------------------
Cactus::cctk_run_title = "simplest Geodesic"
Cactus::cctk_full_warnings         = "yes"

Cactus::terminate        = "iteration"
Cactus::cctk_itlast      =  32
Time::timestep_method    = "given"
Time::timestep           =  0.1

#------------------------------------------------------------------------------
# Activate the necessary thorns (minimal verified set):
#
#   Boundary    boundary condition implementation for the grid
#   CartGrid3D  3D Cartesian grid
#   CoordBase   grid coordinates and boundary handling
#   SymBase     symmetry table (required by the grid)
#   Time        time integration
#   Carpet      AMR driver; in this build it is also the only thorn
#               implementing Cactus group storage, which is required
#               for the particle_arrays variable and for ADMBase
#   CarpetLib   Carpet library
#   CarpetReduce reduction operators (e.g. for timer statistics)
#   IOUtil      IO helpers (required by LoopControl)
#   ADMBase     metric data on the grid, used when Exact = no
#   KerrSchild  Kerr--Schild initial data; auto-activates GenericFD
#               and LoopControl
#   Geodesic    this thorn; auto-activates GSL
#
# Nothing else is needed: Fortran, InitBase, LocalReduce, Periodic, Slab,
# SpaceMask, Constants, CarpetSlab, TerminationTrigger and TimerReport
# can all be omitted without warnings.
#------------------------------------------------------------------------------

ActiveThorns = "Boundary CartGrid3D CoordBase SymBase Time"
ActiveThorns = "Carpet CarpetLib CarpetReduce"
ActiveThorns = "IOUtil"
ActiveThorns = "ADMBase KerrSchild"
ActiveThorns = "Geodesic"

#------------------------------------------------------------------------------
# Diagnostic parameters:
#------------------------------------------------------------------------------

Carpet::output_timers_every = 1024
Carpet::output_timer_tree_every = 256
Carpet::output_initialise_timer_tree = "yes"
Carpet::storage_verbose   = "no"
Carpet::verbose           = "no"
Carpet::veryverbose       = "no"

CarpetLib::output_bboxes  = "no"
CarpetLib::print_memstats_every     = 1024
CarpetLib::memstat_file    = "carpetlib-memory-statistics.asc"

#------------------------------------------------------------------------------
# Run parameters:
#------------------------------------------------------------------------------

#------
# Grid:
#------

Time::dtfac = 0.125

CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CoordBase::domainsize       = "minmax"
CoordBase::spacing          = "numcells"  # "gridspacing" or "numcells"

CoordBase::xmin =  -25.0
CoordBase::ymin =  -25.0
CoordBase::zmin =  -25.0
CoordBase::xmax =   25.0
CoordBase::ymax =   25.0
CoordBase::zmax =   25.0
CoordBase::ncells_x   = 50
CoordBase::ncells_y   = 50
CoordBase::ncells_z   = 50

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_shiftout_z_lower    = 0
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0
CoordBase::boundary_staggered_x_lower   = "yes"
CoordBase::boundary_staggered_y_lower   = "yes"
CoordBase::boundary_staggered_z_lower   = "yes"
CoordBase::boundary_staggered_x_upper   = "yes"
CoordBase::boundary_staggered_y_upper   = "yes"
CoordBase::boundary_staggered_z_upper   = "yes"

Driver::ghost_size                      = 4

# General Carpet parameters:
Carpet::domain_from_coordbase        = "yes"
Carpet::enable_all_storage           = "no"
Carpet::schedule_barriers            = "no"

ADMBase::lapse_timelevels  = 3
ADMBase::shift_timelevels  = 3
ADMBase::metric_timelevels = 3

CarpetLib::poison_new_memory         = "no"
CarpetLib::poison_value              = 114
CarpetLib::check_bboxes              = "no"
CarpetLib::interleave_communications = "yes"
CarpetLib::combine_sends             = "yes"

#------
# MODEL:
#------

# Kerr--Schild initial data on the ADMBase grid (static background;
# needed so that Exact = no runs have a grid to read).
ADMBase::initial_data                = "KerrSchild"
ADMBase::initial_lapse               = "KerrSchild"
ADMBase::initial_shift               = "KerrSchild"
ADMBase::initial_dtlapse             = "KerrSchild"
ADMBase::initial_dtshift             = "KerrSchild"

#----------
# Numerics:
#----------

KerrSchild::M = 2.0
KerrSchild::a = 0.50

#-----------
# Geodesic:
#-----------

# The analytic Kerr--Schild formulas used by Exact = yes are built into
# the thorn; its mass and spin are Geodesic::M / Geodesic::a (they must
# match the KerrSchild initial data if you also want Exact = no to agree).
Geodesic::M                          = 2.0
Geodesic::a                          = 0.50

Geodesic::excised_radius         = 4
Geodesic::initial_radius         = 35.0
Geodesic::particle_rand_xmin     = -35.5
Geodesic::particle_rand_xmax     = 35.5
Geodesic::particle_rand_ymin     = -35.5
Geodesic::particle_rand_ymax     = 35.5
Geodesic::particle_rand_zmin     = -35.0
Geodesic::particle_rand_zmax     = 35.0
Geodesic::particle_middle_sp     = 0.0

Geodesic::Exact                  = "yes"
Geodesic::rverbose               = "yes"
Geodesic::step                   = 100.0  # 100 coord-time units per Cactus step
Geodesic::particle_n_total       = 1
Geodesic::particle_n             = 1

# prograde equatorial circular orbit at grid radius 11.989 (M=2, a=0.5);
# orbit found by the user; u^mu = exact circular-orbit values computed
# from the thorn's exact Kerr--Schild metric.
# particle_tv/xv/yv/zv are the contravariant 4-velocity components
# u^mu = (u^t, u^x, u^y, u^z) in Kerr--Schild coordinates (NOT a
# 3-velocity); the thorn checks g(u,u) = -1 and, if normalized, uses
# them unchanged.
Geodesic::particle_x[0]          = 11.989
Geodesic::particle_y[0]          = 0.0
Geodesic::particle_z[0]          = 0.0
Geodesic::particle_tv[0]         = 1.392812583392655
Geodesic::particle_xv[0]         = 0.0
Geodesic::particle_yv[0]         = 0.5600648870761632
Geodesic::particle_zv[0]         = 0.0

#------------------------------------------------------------------------------
# Output:
#------------------------------------------------------------------------------

IO::out_dir = $parfile
IO::checkpoint_dir                  = $parfile
IO::checkpoint_on_terminate         = "no"

# --- particle dump for visualization ---
Geodesic::particle_dump_every = 1
