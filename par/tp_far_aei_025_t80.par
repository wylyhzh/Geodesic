# =============================================================================
# TwoPunctures geodesic probe, FAR variant: tp_far_aei_025_t80 (metric_interp=aei, via AEILocalInterp)
# Same TwoPunctures GW150914 background, grid as
# tp_local27_025.par (144^3, dx=0.25, no AMR).
# IC: ring r=10, 100 particles, prograde tangential velocity 0.32 (near the
#   Newtonian circular estimate sqrt(M/r) ~ 0.32 for the M~1 merger
#   background), inward radial velocity 0.10.
#   u^t given as 1.774115229207234; the thorn re-solves u^0 from the
#   normalization condition at init (spatial parts kept).
# Purpose: far-from-BH probe run for the paper Sec. 5.6 rewrite.
#   Part of the automatic validation suite (test/test.ccl, default set).
# Run 4p*8t: itlast=80 (t=0..8 Cactus time = 0..80 particle time), dump every 10 steps (8 fires).
# =============================================================================
Cactus::cctk_run_title = "tp_far_aei_025_t80"
Cactus::cctk_full_warnings = "yes"
Cactus::terminate             = "iteration"
Cactus::cctk_itlast           =  80
Time::timestep_method         = "given"
Time::timestep                =  0.1
ActiveThorns = "Boundary CartGrid3D CoordBase InitBase SymBase Time"
ActiveThorns = "Carpet CarpetLib CarpetReduce"
ActiveThorns = "IOUtil"
ActiveThorns = "ADMBase ADMcoupling ADMmacros CoordGauge StaticConformal TwoPunctures"
ActiveThorns = "Geodesic AEILocalInterp LocalInterp"
Carpet::output_initialise_timer_tree = "no"
Carpet::storage_verbose = "no"
Carpet::verbose = "no"
Carpet::veryverbose = "no"
Driver::ghost_size            = 4
CartGrid3D::type              = "coordbase"
CartGrid3D::domain            = "full"
CartGrid3D::avoid_origin      = "no"
CoordBase::domainsize         = "minmax"
CoordBase::spacing            = "numcells"
CoordBase::xmin =  -18.0
CoordBase::xmax =   18.0
CoordBase::ymin =  -18.0
CoordBase::ymax =   18.0
CoordBase::zmin =  -18.0
CoordBase::zmax =   18.0
CoordBase::ncells_x   = 144
CoordBase::ncells_y   = 144
CoordBase::ncells_z   = 144
Carpet::domain_from_coordbase   = "yes"
Carpet::enable_all_storage      = "no"
Carpet::schedule_barriers       = "no"
ADMBase::lapse_timelevels       = 3
ADMBase::shift_timelevels       = 3
ADMBase::metric_timelevels      = 3
ADMBase::metric_type            = "physical"
ADMBase::initial_data            = "twopunctures"
ADMBase::initial_lapse           = "twopunctures-averaged"
ADMBase::initial_shift           = "zero"
ADMBase::initial_dtlapse         = "zero"
ADMBase::initial_dtshift         = "zero"
TwoPunctures::verbose            =  "yes"
