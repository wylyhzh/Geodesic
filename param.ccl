# param.ccl for thorn Geodesic (pure geodesic integrator)
# Licence : GPLv2+ (see COPYING)

# NOTE: no `shares:` clauses -- the thorn is self-contained:
#   - the exact Kerr-Schild metric of Exact=yes mode is built in
#     (parameters M and a below, no dependency on the KerrSchild thorn);
#   - the grid metric of Exact=no mode is fetched from ADMBase through
#     the schedule READS (see schedule.ccl), not through shared
#     parameters.

private:

# ------------------ Kerr parameters (used when Exact = yes) ------------------
REAL M "Kerr black-hole mass (used when Exact = yes)"
{
  0.0:* :: "non-negative"
} 1.0

REAL a "Kerr black-hole spin (used when Exact = yes)"
{
  -1.0:1.0 :: "|a| <= 1"
} 0.0

# ------------------ number of particles ------------------
# particle_n is capped at 100: cactus_sim -Ov prints one record per
# particle array element, and no cactus_sim parameter has ever exceeded
# 100 (the historical limit of this thorn's particle arrays).
INT particle_n "Number of fixed particles (max 100). 0 disables particle evolution."
{
  0:100 :: "Allowed range"
} 0

INT particle_n_total  "Number of total particles. 0 disables particle evolution. particle_n_total >= particle_n"
{
  0:10000 :: "Allowed range"
} 0

# ------------------ initial coordinates ------------------
REAL particle_x[100] "Initial particle x coordinate"
{
  *:* :: "Any value"
} 1.0

REAL particle_y[100] "Initial particle y coordinate"
{
  *:* :: "Any value"
} 1.0

REAL particle_z[100] "Initial particle z coordinate"
{
  *:* :: "Any value"
} 4.0

# ------------------ initial 4-velocity u^mu = dx^mu / dtau ------------------
REAL particle_xv[100] "Initial particle u^x = dx/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_yv[100] "Initial particle u^y = dy/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_zv[100] "Initial particle u^z = dz/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_tv[100] "Initial particle u^t = dt/dtau (auto-corrected)"
{
  *:* :: "Any value"
} 1.0

# ------------------ optional initial radial perturbation ------------------
# Inward (centripetal) radial 4-velocity kick added to every particle's
# initial u^i, so that initially-circular geodesics visibly deviate from a
# circular orbit (become eccentric / precessing).  Magnitude is in the same
# units as particle_xv (contravariant u^i); 0.0 disables the kick.
# 0.05 == |u^phi| of the circular orbit: a strong inward drift, orbit
# clearly departs from circular.
REAL particle_radial_kick "Inward radial 4-velocity kick |u^r| added at init; 0.0 disables"
{
  0.0:* :: "non-negative, in u^i units"
} 0.05

# ------------------ integration ------------------
REAL step "Coordinate time step of the particle integration per Cactus iteration (0.0 = elapsed time since the previous integration)"
{
  0.0:* :: "0.0 uses the elapsed time since the previous integration (the finest level's dt under subcycling, the grid dt for single-level runs); capped to the grid dt when the grid metric is time-varying"
} 0.0

# Exact=yes: metric/Christoffel use exact Kerr-Schild analytic values;
# Exact=no: metric/Christoffel from grid (ADMBase) via 27-point polynomial fit.
BOOLEAN Exact "Use exact Kerr-Schild metric (analytic, no grid needed)"
{
} "no"

BOOLEAN gverbose "Print verbose messages"
{
} "no"

BOOLEAN rverbose "Print Runge-Kutta messages"
{
} "no"

# Fine-level AMR alignment / symmetry diagnostics.  Off-centre or
# un-aligned 1p per-hole AMR patches (e.g. GW150914 double-centre)
# trigger these messages every time the patch is acquired.  They are
# expected in that configuration and only needed when debugging the
# patch-origin handling, so they are off by default.
BOOLEAN amr_align_warn "Print fine-level AMR alignment/symmetry warnings (origin-handling diagnostics; default off)"
{
} "no"

# Dump full particle state (t x y z u^t u^x u^y u^z tau) to the file
# given by particle_dump_file (relative to the working directory),
# once every particle_dump_every iterations.  0 disables.
# Diagnostic only.
INT particle_dump_every "Dump period for the particle state dump (0 = off)"
{
  0:* :: "0 disables"
} 0

STRING particle_dump_file "File name for the particle state dump (parent directories are created as needed)"
{
  ".+" :: "A valid file name"
} "geodesic_particles.txt"


# Policy for particles that leave the domain or fail the 4-velocity
# renormalization:
#   drop    -- set the particle state to NaN and stop tracking it
#   flag    -- freeze the particle at its last state and stop tracking
#              it (the dump keeps the last valid position)
#   respawn -- randomly re-place the particle (legacy Monte-Carlo
#              tracer behavior; not recommended for science runs)
KEYWORD particle_loss_policy "How to handle particles that leave the domain or fail normalization: drop, flag, or respawn"
{
  "drop"    :: "set state to NaN, stop tracking"
  "flag"    :: "freeze at last state, stop tracking"
  "respawn" :: "randomly re-place (legacy)"
} "drop"

# ------------------ random particle generation ------------------
INT particle_rand_seed "random seed"
{
  0:* :: "0 uses 123456789"
} 0

REAL particle_rand_xmin "Random x min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_xmax "Random x max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_rand_ymin "Random y min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_ymax "Random y max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_rand_zmin "Random z min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_zmax "Random z max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_middle_sp "Minimum |z| for respawn"
{
  0.0:1.0
} 1.0

# ------------------ boundary / respawn ------------------
CCTK_REAL initial_radius "Initial radius for particle"
{
  0.0:* :: "non-negative"
} 6.0

CCTK_REAL excised_radius "Euclidean excision radius for particle respawn"
{
  0.0:* :: "non-negative"
} 3.0

# ------------------ AMR ------------------
# Number of Carpet refinement levels to use for the particle grid
# (1 = plain unigrid; must equal Carpet::refinement_levels for an AMR
# run).  Levels beyond this value are ignored.  Max is GEODESIC_MAX_LEVELS.
CCTK_INT geodesic_amr_levels "Number of Carpet refinement levels (max = GEODESIC_MAX_LEVELS)"
{
  1:16 :: "between 1 and GEODESIC_MAX_LEVELS (16)"
} 3
# AMR region center and half-extent (physical units) used to rebuild each
# fine-level patch's origin (the patch is centred on the AMR region in a
# full-extent direction, or on the rank's half of the AMR region in a
# split direction of a 2x2 (y,z) multi-rank run).  For the common case
# where the AMR region sits on the domain centre, amr_center = (0,0,0).
CCTK_REAL amr_center_x "AMR region centre x"
{
  *:* :: "any value"
} 0.0
CCTK_REAL amr_center_y "AMR region centre y"
{
  *:* :: "any value"
} 0.0
CCTK_REAL amr_center_z "AMR region centre z"
{
  *:* :: "any value"
} 0.0
CCTK_REAL amr_radius_x "AMR region half-extent x"
{
  0.0:* :: "non-negative"
} 0.0
CCTK_REAL amr_radius_y "AMR region half-extent y"
{
  0.0:* :: "non-negative"
} 0.0
CCTK_REAL amr_radius_z "AMR region half-extent z"
{
  0.0:* :: "non-negative"
} 0.0

# ------------------ spatial metric interpolation (grid mode, Exact=no) ------------------
# How the particle samples the grid metric / Christoffel symbols:
#   local27 -- the default: a 27-point (3x3x3) Lagrange polynomial fit
#              of the metric and Christoffel symbols around the particle
#              (the historical behavior; bit-identical to previous runs).
#   aei     -- point-wise Lagrange interpolation via AEILocalInterp
#              (order-4 tensor-product), evaluated at the particle
#              position; the 4-metric and its derivatives are composed
#              from the interpolated 3+1 fields and the Christoffel
#              symbols are evaluated point-wise.
#   carpet  -- point-wise interpolation via CarpetInterp
#              (CCTK_InterpGridArrays -> DriverInterpolate).  Single-process
#              only (the particle loop is run serially).
# Ignored when Exact = yes (the analytic Kerr-Schild metric is used).
KEYWORD metric_interp "Spatial metric/Christoffel sampler: local27, aei, or carpet"
{
  "local27" :: "27-point Lagrange polynomial fit (default)"
  "aei"     :: "AEILocalInterp point-wise Lagrange (order 4)"
  "carpet"  :: "CarpetInterp point-wise (single process)"
} "local27"

# ------------------ time interpolation of the grid metric ------------------
# Whether the grid metric is interpolated between the two stored time
# levels during the particle step (grid mode, Exact=no):
#   off    -- the default: the metric value is taken from time level 0
#             (the grid's current time) and the time derivative from the
#             stored time levels (2nd-order backward difference; 0 for a
#             stationary metric).  The historical behavior.
#   linear -- the metric value is linearly interpolated between time
#             level 1 (t - dt) and time level 0 (t) using the particle's
#             fractional coordinate time within the step, and the time
#             derivative is the 1st-order difference (g0 - g1)/dt.  The
#             Christoffel symbols are then evaluated point-wise from the
#             interpolated metric.  (For a time-varying metric the two
#             stored time levels must be readable, e.g. Carpet::init_fill_timelevels
#             = "yes"; with a static metric the two levels coincide.)
# Ignored when Exact = yes or metric_interp = carpet.
KEYWORD time_interp "Time interpolation of the grid metric: off or linear"
{
  "off"    :: "metric from time level 0, 2nd-order time derivative (default)"
  "linear" :: "linear blend of the two time levels, 1st-order time derivative"
} "off"

# ------------------ adaptive (blend-then-inverse) Christoffel for local27 ------------------
# Whether the local27 sampler computes the Christoffel symbols by
# (a) fitting the 4-METRIC from the 27-cell stencil, (optionally blending
#     the two stored time levels), inverting it and differentiating
#     point-wise -- "blend-then-inverse"; this is robust in strong-field
#     regions (it avoids interpolating the rapidly-varying Christoffel
#     directly, which caused superluminal particle drops).  OR
# (b) the historical behaviour: fitting/evaluating the Christoffel
#     symbols themselves (a 27-point polynomial of the pointwise Christoffel
#     fit, optionally blended between the two time levels).
#   on  (default) -- blend-then-inverse (robust; the recommended choice).
#   off             -- historical (fit Christoffel directly).  Useful for
#                      A/B comparison against the robust path.
# Only affects metric_interp = local27 (sinterp_mode 0).  aei and carpet use
# their own point-wise interpolators and are unaffected.
KEYWORD adaptive_interp "Local27 Christoffel: adaptive blend-then-inverse (on, default) vs historical direct Christoffel fit (off)"
{
  "on"  :: "fit metric, (blend time levels), invert, differentiate (robust; default)"
  "off" :: "historical: fit/evaluate the Christoffel symbols directly"
} "on"

# ------------------ strong-curvature trigger for the robust local27 path ------------------
# When the cheap (direct-fit / Christoffel-blend) local27 path is no longer
# trustworthy (deep potential well / poorly-resolved metric), promote the
# particle to the robust (blend-then-inverse) path.  The flag is STICKY: once
# set it stays for the particle's whole life.  Only affects
# metric_interp = local27 (sinterp_mode 0) with adaptive_interp = on;
# aei/carpet and Exact are unaffected.
KEYWORD strong_curv_crit "Strong-curvature trigger for the robust local27 path: u_dot_u (default) or alpha"
{
  "u_dot_u" :: "trigger when the raw (pre-renorm) u·u > u_dot_u_threshold (default); u·u should be -1"
  "alpha"   :: "trigger when the lapse alpha = 1/sqrt(-g^00) < alpha_threshold (default 0.5)"
} "u_dot_u"

REAL u_dot_u_threshold "u_dot_u trigger: promote when raw u·u > this value (default -0.01; -1 = u·u correct)"
{
  -1e+10:1e+10 :: "should be near -1 while the cheap path is accurate"
} -0.01

REAL alpha_threshold "alpha trigger: promote when lapse alpha = 1/sqrt(-g^00) < this value (default 0.5)"
{
  0.0:2.0 :: "lapse; 0.5 ~ Schwarzschild horizon (alpha = 1 - M/r)"
} 0.5

# ------------------ velocity-component magnitude checks (added discriminant) ------------------
# u·u is renormalized to -1, so the u_dot_u / lapse criteria can look healthy
# even when a particle is moving near light speed (|u^0|,|u^i| >> 1).  These
# thresholds add an independent check on the (normalized) 4-velocity components:
#   u0_threshold > 0 -> promote when |u^0| (dt/dtau, time comp.) exceeds it;
#   ui_threshold   > 0 -> promote when any |u^i| (spatial comp.) exceeds it.
# 0 disables that component's check, so the defaults (0) keep existing
# behaviour unchanged until the user tunes the values.  Applied at the
# step-start promotion and as an in-step re-do trigger for the robust path.
# Only affects metric_interp = local27 (sinterp_mode 0).
REAL u0_threshold "velocity-component trigger: promote when |u^0| (time) > this value; 0 = off (default)"
{
  0.0:1e+10 :: "|u^0| = dt/dtau; 0 = time-component check off"
} 0.0

REAL ui_threshold "velocity-component trigger: promote when any |u^i| (spatial) > this value; 0 = off (default)"
{
  0.0:1e+10 :: "spatial 4-velocity components; 0 = spatial-component check off"
} 0.0

# ------------------ strong-region Christoffel source (local27, adaptive_interp=on) ------------------
# How the robust (use_robust) path builds its Christoffel in the strong region:
#   "hybrid" (default): metric VALUE from AEI order-4 pointwise, Christoffel
#       DERIVATIVES from l27 poly27 fits (the current strong-region behaviour).
#   "l27": all-l27 — metric value AND derivatives from l27 (robust blend-then-
#       inverse).  Pure local27; no AEI values.  A/B-testable against "hybrid".
# Only affects metric_interp = local27 (sinterp_mode 0). aei/carpet/Exact use
# their own point-wise interpolators and are unaffected.
KEYWORD strong_christoffel "Strong-region Christoffel source (local27 robust path): hybrid (AEI value + l27 derivative) or l27 (all-l27)"
{
  "hybrid" :: "metric value from AEI order-4, Christoffel derivatives from l27 poly27 (current default)"
  "l27"    :: "metric value AND derivatives all from l27 (blend-then-inverse); pure local27"
} "hybrid"

# ------------------ log-space metric interpolation (qwen1.txt) ------------------
# For the robust (adaptive) local27 path, the metric VALUE is normally from
# the AEI order-4 (Lagrange) pointwise interpolant.  In the strong-curvature
# region a plain 4th-order Lagrange fit can oscillate; interpolating the
# positive-definite ADM fields in log|.| space tames the power-law (1/r)
# behaviour.  "yes" uses a 5-node order-4 tensor-product Lagrange molecule
# (identical to AEI a4) on log|.| for gxx/gyy/gzz/lapse and regular space
# for the six sign-changing fields (off-diagonal metric + shift); it agrees
# with AEI to O(dx^4) on a smooth metric.  Falls back to plain AEI when the
# point is too close to the grid boundary for the 5-node stencil.
# Only affects metric_interp = local27 (sinterp_mode 0) with use_robust.
KEYWORD log_metric_interp "Robust-path metric value: log|.| space (yes) or regular AEI space (no, default)"
{
  "no"  :: "plain AEI order-4 metric values (current default)"
  "yes" :: "log|.| space for gxx/gyy/gzz/lapse; regular space for the rest"
} "no"

# ------------------ robust-path interpolation engine (true 4D) --------------
# For the local27 robust (use_robust) path with strong_christ_off = "hybrid"
# (the AEI strong-region path), "aei" uses the AEI order-4 pointwise
# interpolant (5-node space x 2-level time blend) for both the metric value
# and the Christoffel, as before.  "fourd" replaces it with a true 4D
# tensor product: a 5-node order-4 Lagrange molecule in space (identical to
# AEI a4) times a 3-node order-2 Lagrange over the three stored ADMBase
# levels [0]=t, [1]=t-dt, [2]=t-2dt, evaluated at the particle's fractional
# time s = geodesic_time_theta.  Value and all four derivatives come from one
# consistent interpolant at the particle's true time (value O(dt^3), time
# derivative O(dt^2) -- more accurate and more consistent than the AEI 2-level
# blend).  On boundary / level failure it falls back to the plain AEI path,
# so a static run is bit-identical to the "aei" setting.  Only affects
# metric_interp = local27 (sinterp_mode 0), use_robust, strong_christ_off = 0.
KEYWORD robust_metric_interp "Robust-path (strong_christ_off=hybrid) interpolation engine: true 4D tensor product (fourd) or AEI order-4 (aei, default)"
{
  "aei"   :: "AEI order-4 pointwise (5-node space x 2-level time blend; current default, log-space optional via log_metric_interp)"
  "fourd" :: "true 4D tensor product: 5-node order-4 space x 3-node order-2 time Lagrange over levels [t,t-dt,t-2dt]; value+all-derivatives from one interpolant; falls back to AEI on boundary/level failure"
} "aei"

# ------------------ smoke test for the time-varying code path ------------------
# The two stored ADMBase time levels coincide in a static-metric run, so
# time_interp = linear and the (g0 - g1)/dt derivative are exact no-ops and
# cannot be exercised.  This hook multiplies the OLDER (t - dt) level's
# sampled values (metric samples and, for local27, the pointwise Christoffel
# samples) by (1 - smoke_timedep_eps) inside the Geodesic interpolators,
# WITHOUT touching the grid arrays (no persistence through ADMBase_Static).
# 0.0 (default) is a strict no-op: the runs are bit-identical to the
# un-hooked build.  With a small positive eps the two levels differ, so a
# static run can smoke-test the linear path: no crash / no NaN,
# linear != off, and linear -> off as eps -> 0.  Diagnostic only; do not
# use for production runs.  Ignored when time_interp = off (the off path
# never reads the old level for the metric value) or metric_interp = carpet.
REAL smoke_timedep_eps "Smoke test: scale the old (t - dt) metric level by (1 - eps); 0 disables (default)"
{
  0.0:0.5 :: "0 disables; keep small"
} 0.0
