# param.ccl for thorn Geodesic (pure geodesic integrator)
# Licence : GPLv2+ (see COPYING)

# NOTE: no `shares:` clauses -- the thorn is self-contained:
#   - the exact Kerr-Schild metric of Exact=yes mode is built in
#     (parameters M and a below, no dependency on the KerrSchild thorn);
#   - the grid metric of Exact=no mode is fetched from ADMBase through
#     the schedule READS (see schedule.ccl), not through shared
#     parameters.

private:

# ------------------ Kerr parameters (used when Exact = yes) ------------------
REAL M "Kerr black-hole mass (used when Exact = yes)"
{
  0.0:* :: "non-negative"
} 1.0

REAL a "Kerr black-hole spin (used when Exact = yes)"
{
  -1.0:1.0 :: "|a| <= 1"
} 0.0

# ------------------ number of particles ------------------
# Explicit per-particle parameters are declared for the first 1000
# particles (matching the particle_n / particle_n_total ranges).  Runs
# with more than 1000 explicitly listed particles are not supported
# through parfiles; use particle_n (fixed part) <= 1000 and fill the
# rest with random initial conditions via particle_n_total.
INT particle_n "Number of fixed particles (max 1000). 0 disables particle evolution."
{
  0:1000 :: "Allowed range"
} 0

INT particle_n_total  "Number of total particles. 0 disables particle evolution. particle_n_total >= particle_n"
{
  0:10000 :: "Allowed range"
} 0

# ------------------ initial coordinates ------------------
REAL particle_x[1000] "Initial particle x coordinate"
{
  *:* :: "Any value"
} 1.0

REAL particle_y[1000] "Initial particle y coordinate"
{
  *:* :: "Any value"
} 1.0

REAL particle_z[1000] "Initial particle z coordinate"
{
  *:* :: "Any value"
} 4.0

# ------------------ initial 4-velocity u^mu = dx^mu / dtau ------------------
REAL particle_xv[1000] "Initial particle u^x = dx/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_yv[1000] "Initial particle u^y = dy/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_zv[1000] "Initial particle u^z = dz/dtau (contravariant 4-velocity component; NOT a 3-velocity)"
{
  *:* :: "Any value"
} 0.0

REAL particle_tv[1000] "Initial particle u^t = dt/dtau (auto-corrected)"
{
  *:* :: "Any value"
} 1.0

# ------------------ integration ------------------
REAL step "Coordinate time step of the particle integration per Cactus iteration (0.0 = elapsed time since the previous integration)"
{
  0.0:* :: "0.0 uses the elapsed time since the previous integration (the finest level's dt under subcycling, the grid dt for single-level runs); capped to the grid dt when the grid metric is time-varying"
} 0.0

# Coordinate time before which the particles are held at their initial state
# (not integrated at all).  With an evolved spacetime the first few M are
# dominated by the spurious "junk" transient of the constraint-solving initial
# data; a geodesic started at t=0 accumulates that transient as if it were
# physical.  At the first step with cctk_time >= particle_start_time the
# particle clock is re-anchored to that step, so the worldline starts there
# from the initial position and velocity.  0.0 = integrate from the initial
# time (the historical behaviour).
REAL particle_start_time "Coordinate time before which particles are held fixed (0.0 = integrate from the initial time)"
{
  0.0:* :: "hold every particle at its initial position and velocity until the grid reaches this time, then release it"
} 0.0

# Same hold, counted in integration steps instead of coordinate time: the
# particles are integrated from integration step N onwards, so 0 integrates
# from step 0 (no hold) and 1 skips only step 0.  A step count is resolution
# independent: the junk transient of the initial data crosses a fixed number
# of CFL steps per refinement level, so the matching hold is 2 steps at
# h=1/4, 4 at h=1/8, 8 at h=1/16 (the same physical time when dt = cfl*dx).
# The two holds compose: particles are integrated only once both the step
# count and the coordinate time are past their thresholds.  At the release
# step the 4-velocity is normalized against the metric sampled there (the
# ring IC's velocity is defined with respect to the analytic background, not
# to the evolved numerical metric), and nothing is dumped before release.
# How the 4-velocity is set at the release step.  "normalize" rescales the IC
# velocity so that g(u,u) = -1 in the sampled metric (it also rescales the
# spatial velocity, which for the TP-ring IC means a factor ~1.9).
# "fix_E_Lz" instead keeps the conserved quantities of the IC velocity measured
# in the sampled numerical metric, E = -u_t and L_z = x u_y - y u_x, and
# rebuilds a circular 4-velocity (u^r = u^z = 0, omega = dphi/dt) at the same
# position from them, then renormalizes (which rescales E and L_z by the same
# factor, so L_z/E is preserved exactly).  E and L_z cannot both be kept exact
# while also imposing u^r = 0 and g(u,u) = -1 at a fixed radius -- three
# conditions for two unknowns -- so the norm is the condition enforced exactly.
KEYWORD particle_start_velocity "How to set the 4-velocity at the release step"
{
  "normalize" :: "rescale the IC velocity to g(u,u) = -1 (default)"
  "fix_E_Lz"  :: "keep E and L_z from the IC in the sampled metric, rebuild a circular orbit"
} "normalize"

INT particle_start_steps "First integration step at which particles are advanced (0 = advance from step 0)"
{
  0:* :: "integrate every particle from this integration step on, holding it at its initial position and velocity before that"
} 0

# Maximum number of tau-steps (Runge-Kutta sub-steps) the ODE loop may take
# for one particle within a single Cactus iteration.  Near the black-hole
# horizons the step shrinks and many sub-steps are needed, so a large cap makes
# integration slow.  Lower it to speed up runs; the historical 100002 is rarely
# needed for well-resolved runs.  Too low a value may abort a particle that
# needs more sub-steps.  Default 2000.
INT max_iter_cap "Max ODE tau-steps per particle per Cactus iteration (tau-loop cap; default 2000)"
{
  1:* :: "Must be >= 1"
} 2000

# Exact=yes: metric/Christoffel use exact Kerr-Schild analytic values;
# Exact=no: metric/Christoffel from grid (ADMBase) via 27-point polynomial fit.
BOOLEAN Exact "Use exact Kerr-Schild metric (analytic, no grid needed)"
{
} "no"

BOOLEAN gverbose "Print verbose messages"
{
} "no"

BOOLEAN rverbose "Print Runge-Kutta messages and the norm diagnostics (u.u range after renormalization; |u.u+1| before renormalization for this step and for the run)"
{
} "no"

# Fine-level AMR alignment / symmetry diagnostics.  Off-centre or
# un-aligned 1p per-hole AMR patches (e.g. GW150914 double-centre)
# trigger these messages every time the patch is acquired.  They are
# expected in that configuration and only needed when debugging the
# patch-origin handling, so they are off by default.
BOOLEAN amr_align_warn "Print fine-level AMR alignment/symmetry warnings (origin-handling diagnostics; default off)"
{
} "no"

# Dump full particle state (t x y z u^t u^x u^y u^z tau) to the file
# given by particle_dump_file (relative to the working directory),
# once every particle_dump_every iterations.  0 disables.
# Diagnostic only.
INT particle_dump_every "Dump period for the particle state dump (0 = off)"
{
  0:* :: "0 disables"
} 0

STRING particle_dump_file "File name for the particle state dump (parent directories are created as needed)"
{
  ".+" :: "A valid file name"
} "geodesic_particles.txt"

KEYWORD particle_dump_mode "How to open the particle dump file at the first dump"
{
  "auto"     :: "append when a checkpointing IO thorn (CarpetIOHDF5/CarpetIOF5) is active, otherwise start clean"
  "truncate" :: "always start the file clean"
  "append"   :: "always continue an existing file"
} "auto"


# Policy for particles that leave the domain or fail the 4-velocity
# renormalization:
#   drop    -- set the particle state to NaN and stop tracking it
#   flag    -- freeze the particle at its last state and stop tracking
#              it (the dump keeps the last valid position)
#   respawn -- randomly re-place the particle (legacy Monte-Carlo
#              tracer behavior; not recommended for science runs)
KEYWORD particle_loss_policy "How to handle particles that leave the domain or fail normalization: drop, flag, or respawn"
{
  "drop"    :: "set state to NaN, stop tracking"
  "flag"    :: "freeze at last state, stop tracking"
  "respawn" :: "randomly re-place (legacy)"
} "drop"

# ------------------ random particle generation ------------------
INT particle_rand_seed "random seed"
{
  0:* :: "0 uses 123456789"
} 0

REAL particle_rand_xmin "Random x min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_xmax "Random x max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_rand_ymin "Random y min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_ymax "Random y max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_rand_zmin "Random z min"
{
  *:* :: "Any value"
} -1e+10

REAL particle_rand_zmax "Random z max"
{
  *:* :: "Any value"
} 1e+10

REAL particle_middle_sp "Minimum |z| for respawn"
{
  0.0:1.0
} 1.0

# ------------------ boundary / respawn ------------------
CCTK_REAL initial_radius "Initial radius for particle"
{
  0.0:* :: "non-negative"
} 6.0

CCTK_REAL excised_radius "Euclidean radius around the origin: a particle that enters it is handed to the loss policy, and random particle placement starts outside it (0 disables both)"
{
  0.0:* :: "non-negative"
} 3.0

# ------------------ AMR ------------------
# Number of Carpet refinement levels to use for the particle grid
# (1 = plain unigrid; must equal Carpet::refinement_levels for an AMR
# run).  Levels beyond this value are ignored.  Max is GEODESIC_MAX_LEVELS.
CCTK_INT geodesic_amr_levels "Number of Carpet refinement levels (max = GEODESIC_MAX_LEVELS)"
{
  1:16 :: "between 1 and GEODESIC_MAX_LEVELS (16)"
} 3

# ------------------ spatial metric interpolation (grid mode, Exact=no) ------------------
# How the particle samples the grid metric / Christoffel symbols:
#   l27     -- the simplest sampler: a 27-point (3x3x3) Lagrange polynomial
#              fit of the metric and of the nodal 6th-order-FD Christoffel
#              symbols (the l27 "differentiate-then-interpolate"
#              convention) around the particle, from the current time
#              level only.  Node-exact on the 27 stencil nodes.  If a
#              staged fit is degenerate / non-finite the particle is
#              dropped by the loss policy (no fallback interpolant).
#   local27 -- the default: a self-contained 125-node (5x5x5) quartic
#              tensor-product polynomial fit of the metric (and of the
#              nodal 6th-order-FD Christoffel symbols) around the
#              particle, fitted with the precomputed separable inverse
#              Vandermonde (= the 125x125 MtxA analogue); the three
#              stored time levels are blended with a 3-node Lagrange in
#              the particle's coordinate time.  Node-exact on all 125
#              grid nodes.  Uses no interpolator from another thorn.
#   aei     -- point-wise Lagrange interpolation via AEILocalInterp
#              (order-4 tensor-product), evaluated at the particle
#              position; the 4-metric and its derivatives are composed
#              from the interpolated 3+1 fields and the Christoffel
#              symbols are evaluated point-wise.  The two stored time
#              levels are linearly blended in the particle's coordinate
#              time.
#   carpet  -- point-wise sampler with the same AEILocalInterp order-4
#              spatial molecule as aei; the time derivative is the
#              carpet-style 2nd-order 3-point difference of the full
#              4-metric.  Like aei, it is thread-safe and runs under
#              the owner-computes multi-process mode.
# Ignored when Exact = yes (the analytic Kerr-Schild metric is used).
#
# Memory: the stencil caches are per-particle and are allocated only for
# the selected sampler -- l27 35 kB/particle, local27 241 kB/particle,
# aei / carpet 0 (pointwise, no stencil cache).  At the
# particle_n_total limit of 10000 that is 0.35 GB / 2.4 GB / ~0 GB.
# Choosing: a stationary (or effectively stationary) background --
# Exact = yes, KerrSchild, or ID data that has settled -- is well served
# by l27, which is the cheapest and the simplest to read; for a
# dynamical spacetime (binary-black-hole merger, GW150914-like) use
# local27, the default, when memory allows, and aei / carpet when it
# does not.  aei / carpet need the AEILocalInterp thorn active (they
# resolve the interpolator registered as "Lagrange polynomial
# interpolation" and abort if it is missing); l27 and local27 are
# self-contained.
KEYWORD metric_interp "Spatial metric/Christoffel sampler: l27, local27, aei, carpet, or carpetx"
{
  "l27"      :: "simplest 27-point Lagrange fit (current time level only; particle dropped on fit failure; 35 kB/particle cache; best for stationary metrics)"
  "local27"  :: "125-node 5x5x5 quartic tensor-product fit, 3 time levels (default; self-contained, no AEI; 241 kB/particle cache)"
  "aei"      :: "AEILocalInterp point-wise Lagrange (order 4; no per-particle cache; needs the AEILocalInterp thorn)"
  "carpet"   :: "AEI order-4 spatial molecule + carpet-style time derivative (no per-particle cache; needs AEILocalInterp)"
  "carpetx"  :: "CarpetX point-wise interpolation of ADMBaseX (order = CarpetX::interpolation_order; no per-particle cache; static metric; needs the CarpetX thorn)"
} "local27"

# ------------------ interpolation-error probe (diagnostic) ------------------
# Opt-in diagnostic that answers "which interpolated quantity carries the
# largest error?".  When probe_file is non-empty, every probe_stride-th
# geodesic right-hand-side evaluation writes a block of rows comparing what
# the selected sampler produced with the exact Kerr-Schild values at the same
# event: the 10 independent g_{mu nu}, the 10 independent g^{mu nu} and the
# 40 independent Gamma^mu_{alpha beta} (alpha <= beta), each with the
# sub-cell offset of the sample point from its nearest grid node.  Written to
# a sidecar text file, never to particle_dump_file.
# Empty (the default) makes the probe entirely inert: no extra evaluations,
# no extra output, and the integration path is bit-identical to a build
# without the probe.  With more than one MPI rank integrating particles each
# rank writes its own <probe_file>.proc<N>.  Skipped for Exact = yes (nothing
# is interpolated there) and for metric_interp = carpetx (its interpolator is
# an MPI collective and cannot be re-entered from the probe).
STRING probe_file "File name for the interpolation-error probe sidecar (empty = probe off)"
{
  ".*" :: "A file name, or the empty string to switch the probe off"
} ""

INT probe_stride "Evaluate the probe once every N geodesic RHS evaluations"
{
  1:* :: "Must be >= 1"
} 1

INT probe_max_rows "Cap on probe rows written (0 = unlimited; applied per block, so the count can overshoot by up to 60 rows)"
{
  0:* :: "0 disables the cap"
} 200000
