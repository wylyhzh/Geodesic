# build artifacts
build/
*.o
*.so

# editor / OS cruft
*~
.*.swp
.DS_Store

# Cactus runtime output
*.out
*.err

# python cache
__pycache__/
*.pyc

# Cactus runtime signal file
test/TERMINATE

# testsuite helper binary (auto-built by the util/check_conserved wrapper)
util/check_conserved.bin

# ThornGuide build artifacts
doc/*.aux
doc/*.log
doc/*.out
doc/documentation.pdf

# regression reference backups taken before re-running a test
*.bak-*

# ThornDocHTML figure-conversion artifacts
# (any PDF under doc/ gets converted to EPS by make -ThornDocHTML)
doc/*.eps

# manuscript LaTeX build artifacts (the .bbl files are kept in-tree)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper_zh/*.aux
paper_zh/*.log
paper_zh/*.out
paper_zh/*.blg
