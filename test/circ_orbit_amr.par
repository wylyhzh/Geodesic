#------------------------------------------------------------------------------
# Testsuite parfile: Geodesic/circ_orbit_amr
#
# 100 particles (see below) through the Exact = no interpolation path,
# with a static 2-level spherical refinement centred on the origin
# (CarpetRegrid2):
#
#   level 1: box [-16,16]^3, dx = 0.5
#   level 2: box [-8,8]^3,    dx = 0.25
#
# The orbit radius 11.989 lies inside the level-1 safe region, so every
# particle is always sampled on the level-1 grid; the run still
# traverses all three levels (4:1 subcycling) and exercises the
# per-level acquire, the stationary-metric detection on every level,
# the pick_level fallback, and the sync trigger.  Single process:
# multi-process AMR runs are not supported (README, Limitations).
#
# The full particle state is dumped at every coarse step to
# circ_orbit_amr/geodesic_particles.txt (relative to the test run
# directory); the testsuite compares it with the reference data in
# test/circ_orbit_amr/.
#
# Keep in sync with circ_orbit_100.par (same 100 particles and grid;
# only the refinement differs).  cctk_itlast counts finest-level
# substeps: with 4:1 subcycling, itlast = 128 gives the same number of
# coarse (level-0) steps as itlast = 32 in the other tests.
#
# CarpetRegrid2 convention: num_levels_1 is one larger than the
# highest refinement level (the radius arrays are 1-based and index 0
# is unused), so num_levels_1 = 3 creates levels 1 and 2; accordingly
# Carpet::max_refinement_levels must be >= 3 (it counts levels 0..N-1).
#------------------------------------------------------------------------------
Cactus::cctk_run_title = "Geodesic test circ_orbit_amr"
Cactus::cctk_itlast      =  128
Time::timestep_method    = "given"
Time::timestep           =  0.1

ActiveThorns = "Boundary CartGrid3D CoordBase SymBase Time"
ActiveThorns = "Carpet CarpetLib CarpetReduce CarpetRegrid2"
ActiveThorns = "IOUtil"
ActiveThorns = "ADMBase KerrSchild"
ActiveThorns = "Geodesic"
Cactus::cctk_full_warnings         = "yes"

Cactus::terminate        = "iteration"
Carpet::output_timers_every = -1
Carpet::output_timer_tree_every = 0
Carpet::output_initialise_timer_tree = "no"
Carpet::storage_verbose   = "no"
Carpet::verbose           = "no"
Carpet::veryverbose       = "no"
# fill the ADMBase past time levels (1,2) with the current values so
# the Geodesic thorn sees a consistent (static) 3-level history
Carpet::init_fill_timelevels = "yes"

CarpetLib::output_bboxes  = "no"
CarpetLib::print_memstats_every     = -1
CarpetLib::memstat_file  = "carpetlib-memory-statistics.asc"

#------
# Grid:
#------

Time::dtfac = 0.125

CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CoordBase::domainsize       = "minmax"
CoordBase::spacing          = "numcells"

CoordBase::xmin =  -25.0
CoordBase::ymin =  -25.0
CoordBase::zmin =  -25.0
CoordBase::xmax =   25.0
CoordBase::ymax =   25.0
CoordBase::zmax =   25.0
CoordBase::ncells_x   = 50
CoordBase::ncells_y   = 50
CoordBase::ncells_z   = 50

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_shiftout_z_lower    = 0
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0
CoordBase::boundary_staggered_x_lower   = "yes"
CoordBase::boundary_staggered_y_lower   = "yes"
CoordBase::boundary_staggered_z_lower   = "yes"
CoordBase::boundary_staggered_x_upper   = "yes"
CoordBase::boundary_staggered_y_upper   = "yes"
CoordBase::boundary_staggered_z_upper   = "yes"

Driver::ghost_size                      = 4

Carpet::domain_from_coordbase        = "yes"
Carpet::enable_all_storage           = "no"
Carpet::schedule_barriers            = "no"

ADMBase::lapse_timelevels  = 3
ADMBase::shift_timelevels  = 3
ADMBase::metric_timelevels = 3

CarpetLib::poison_new_memory         = "no"
CarpetLib::poison_value              = 114
CarpetLib::check_bboxes              = "no"
CarpetLib::interleave_communications = "yes"
CarpetLib::combine_sends             = "yes"

#------
# MODEL:
#------

ADMBase::initial_data                = "KerrSchild"
ADMBase::initial_lapse               = "KerrSchild"
ADMBase::initial_shift               = "KerrSchild"
ADMBase::initial_dtlapse             = "KerrSchild"
ADMBase::initial_dtshift             = "KerrSchild"

#----------
# Numerics:
#----------

KerrSchild::M = 2.0
KerrSchild::a = 0.50

Geodesic::M                          = 2.0
Geodesic::a                          = 0.50

Geodesic::excised_radius         = 4
Geodesic::initial_radius         = 35.0

Geodesic::Exact                  = "no"
Geodesic::rverbose               = "no"
Geodesic::gverbose               = "no"
Geodesic::step                   = 100.0
Geodesic::particle_n_total       = 100
Geodesic::particle_n             = 100

# 100 particles on a ring of prograde equatorial circular orbits at
# radius 11.989 (M=2, a=0.5): particle i sits at angle 2*pi*i/100 with
# the rotated circular-orbit 4-velocity of the reference particle
# (particle 0 is exactly the circ_orbit test particle).

#--- static 2-level spherical refinement, centred on the origin ---
Carpet::max_refinement_levels        = 3
Carpet::refinement_factor            = 2
Carpet::refinement_centering         = "cell"

CarpetRegrid2::verbose               = "no"
CarpetRegrid2::num_centres           = 1
CarpetRegrid2::active_1              = "yes"
CarpetRegrid2::num_levels_1          = 3
CarpetRegrid2::position_x_1          = 0.0
CarpetRegrid2::position_y_1          = 0.0
CarpetRegrid2::position_z_1          = 0.0
# radius_1[k] = half-width of the level-k box (CarpetRegrid2):
# level 1 (dx = 0.5) is the outer box, level 2 (dx = 0.25) the inner
CarpetRegrid2::radius_1[1]           = 16.0
CarpetRegrid2::radius_1[2]           = 8.0

Geodesic::geodesic_amr_levels        = 3

Geodesic::particle_x[0]         = 11.989
Geodesic::particle_y[0]         = 0.0
Geodesic::particle_z[0]         = 0.0
