#------------------------------------------------------------------------------
# Testsuite parfile: Geodesic/ellipse_orbit_amr16
#
# 100 particles on one bound equatorial elliptic geodesic (Kerr M = 2,
# a = 0.5, Kerr-Schild coordinates), pericentre Rp = 16, apocentre at
# (64, 0, 0) (e = 0.6).  Particle 0 sits at the apocentre, particle i
# at azimuth phi_i = 2*pi*i/100 of the first winding of the precessing
# orbit (E = 0.97615167786747858, L_z = 8.1632195500198179).  The
# moderate precession (117.5 deg = 0.6528 pi per radial period,
# T_r = 1349.7) keeps the first winding a thin spiral arc, r in
# [16, 64], so the particles occupy three levels at t = 0: level 2
# (9..18) 36, level 1 (18..36) 42, level 0 (36..72) 22; none lies in
# level 3 (r < 9).
#
# Geodesic::Exact = "yes" switches the particle ODE to the built-in
# analytic Kerr-Schild metric and Christoffel symbols (sexact branch);
# the other four files set Exact = "no" and exercise the grid-metric
# interpolation path (Geodesic::metric_interp below).  For the old
# strongly precessing orbit (Rp = 8.5, ~4.02 pi per radial period) the
# coherent 1e-4 error of the 2nd-order grid metric drifted E/L_z by
# ~1e-3..1e-2 per radial period and pushed the near-pericentre
# particles across the family's plunge boundary into the excision
# sphere (r < 4); Rp = 16 is chosen so that the exact reference and
# all interpolators complete the run without drops, isolating the
# interpolator-to-interpolator differences compared in the paper.
# With Exact = "yes" the initial states are kept unchanged at init
# (norm = -1 exactly) and E/L_z are conserved to integrator precision
# (~1e-12, verified with util/check_conserved, which uses the full
# Killing momenta including the g_{t*} u^t shift terms).
#
# Static 3-level spherical refinement centred on the origin
# (CarpetRegrid2):
#
#   level 1: box [-36,36]^3, dx = 0.5
#   level 2: box [-18,18]^3, dx = 0.25
#   level 3: box [-9,9]^3,   dx = 0.125
#
# on a 144^3 base grid of dx = 1 (domain +-72).  Subcycling is NOT
# enabled in this run (Time::subcycling is off), so all four levels
# advance together with dt = 0.1 and cctk_itlast = 320 counts plain
# Cactus steps.  The run exercises the per-level grid acquire
# (geometry) at every level, the pick_level fallback, and particles
# crossing level boundaries in both directions (the near-pericentre
# particles pass Rp = 16 and come back out over ~2.37 radial
# oscillations; with Geodesic::step = 10 the particle coordinate time
# advances to 3200).
# Four MPI processes (local27 path only).  The aei / carpet / exact
# members of this test set are single-process: the AEI pointwise
# interpolant is not usable in the 4-rank configuration (AEILocalInterp
# ghost-zone bug), and the Exact=yes reference is defined single-process.
#
# The full particle state is dumped at every coarse step to
# ellipse_orbit_amr16_exactno_l27_mp4/geodesic_particles.txt (relative to the test run
# directory); the testsuite compares it with the reference data in
# test/ellipse_orbit_amr/.

#
# CarpetRegrid2 convention: num_levels_1 is one larger than the
# highest refinement level (the radius arrays are 1-based and index 0
# is unused), so num_levels_1 = 4 creates levels 1, 2 and 3;
# accordingly Carpet::max_refinement_levels must be >= 4 (it counts
# levels 0..N-1).
#------------------------------------------------------------------------------
Cactus::cctk_run_title = "Geodesic test ellipse_orbit_amr16 (Exact=no, 4 procs, metric_interp=local27)"
Cactus::cctk_itlast      =  320
Time::timestep_method    = "given"
Time::timestep           =  0.1

ActiveThorns = "Boundary CartGrid3D CoordBase SymBase Time"
ActiveThorns = "Carpet CarpetLib CarpetReduce CarpetRegrid2"
ActiveThorns = "IOUtil"
ActiveThorns = "ADMBase KerrSchild"
ActiveThorns = "Geodesic"
Cactus::cctk_full_warnings         = "yes"

Cactus::terminate        = "iteration"
Carpet::output_timers_every = -1
Carpet::output_timer_tree_every = 256
Carpet::output_initialise_timer_tree = "no"
Carpet::storage_verbose   = "no"
Carpet::verbose           = "no"
Carpet::veryverbose       = "no"
# fill the ADMBase past time levels (1,2) with the current values so
# the Geodesic thorn sees a consistent (static) 3-level history
Carpet::init_fill_timelevels = "yes"

CarpetLib::output_bboxes  = "no"
CarpetLib::print_memstats_every     = -1
CarpetLib::memstat_file  = "carpetlib-memory-statistics.asc"

#------
# Grid:
#------

Time::dtfac = 0.125

CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CoordBase::domainsize       = "minmax"
CoordBase::spacing          = "numcells"

CoordBase::xmin =  -72.0
CoordBase::ymin =  -72.0
CoordBase::zmin =  -72.0
CoordBase::xmax =   72.0
CoordBase::ymax =   72.0
CoordBase::zmax =   72.0
CoordBase::ncells_x   = 144
CoordBase::ncells_y   = 144
CoordBase::ncells_z   = 144

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_shiftout_z_lower    = 0
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0
CoordBase::boundary_staggered_x_lower   = "yes"
CoordBase::boundary_staggered_y_lower   = "yes"
CoordBase::boundary_staggered_z_lower   = "yes"
CoordBase::boundary_staggered_x_upper   = "yes"
CoordBase::boundary_staggered_y_upper   = "yes"
CoordBase::boundary_staggered_z_upper   = "yes"

Driver::ghost_size                      = 4

Carpet::domain_from_coordbase        = "yes"
Carpet::enable_all_storage           = "no"
Carpet::schedule_barriers            = "no"

ADMBase::lapse_timelevels  = 3
ADMBase::shift_timelevels  = 3
ADMBase::metric_timelevels = 3

CarpetLib::poison_new_memory         = "no"
CarpetLib::poison_value              = 114
CarpetLib::check_bboxes              = "no"
CarpetLib::interleave_communications = "yes"
CarpetLib::combine_sends             = "yes"

#------
# MODEL:
#------

ADMBase::initial_data                = "KerrSchild"
ADMBase::initial_lapse               = "KerrSchild"
ADMBase::initial_shift               = "KerrSchild"
ADMBase::initial_dtlapse             = "KerrSchild"
ADMBase::initial_dtshift             = "KerrSchild"

#----------
# Numerics:
#----------

KerrSchild::M = 2.0
KerrSchild::a = 0.50

Geodesic::M                          = 2.0
Geodesic::a                          = 0.50

Geodesic::excised_radius         = 4
Geodesic::initial_radius         = 35.0

Geodesic::Exact                  = "no"
Geodesic::rverbose               = "no"
Geodesic::gverbose               = "no"
Geodesic::step                   = 10.0
Geodesic::particle_n_total       = 100
Geodesic::particle_n             = 100

# 100 particles on one bound equatorial elliptic geodesic
# (Kerr M = 2, a = 0.5, Kerr-Schild coordinates): E =
# 0.97615167786747858, L_z = 8.1632195500198179, pericentre
# Rp = 16, apocentre (64, 0, 0); particle i at azimuth
# 2*pi*i/100 of the first winding of the precessing orbit.

#--- static 3-level spherical refinement, centred on the origin ---
Carpet::max_refinement_levels        = 4
Carpet::refinement_factor            = 2
Carpet::refinement_centering         = "cell"

CarpetRegrid2::verbose               = "no"
CarpetRegrid2::num_centres           = 1
CarpetRegrid2::active_1              = "yes"
CarpetRegrid2::num_levels_1          = 4
CarpetRegrid2::position_x_1          = 0.0
CarpetRegrid2::position_y_1          = 0.0
CarpetRegrid2::position_z_1          = 0.0
# radius_1[k] = half-width of the level-k box (CarpetRegrid2):
# level 1 (dx = 0.5) is the outer box, level 3 (dx = 0.125)
# the innermost
CarpetRegrid2::radius_1[1]           = 36.0
CarpetRegrid2::radius_1[2]           = 18.0
CarpetRegrid2::radius_1[3]           = 9.0

Geodesic::geodesic_amr_levels        = 4

Geodesic::particle_x[0]        = 64
