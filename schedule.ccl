# schedule.ccl for thorn Geodesic
# Licence : GPLv2+ (see COPYING)

# Parameter validation (runs at Cactus start-up)
schedule Geodesic_ParamCheck at CCTK_PARAMCHECK
{
  LANG: C
} "Check Geodesic parameters"

# Initialization: set the initial particle state from the parameters.
# Called once per grid component (Carpet level mode); the levfac guard
# inside Geodesics_init keeps only the level-0 call, so the initialisation
# runs exactly once.
schedule Geodesics_init at CCTK_INITIAL
{
  LANG: C
} "Initialize particle tracker"

# Main integration step.
#
# Called once per grid component (Carpet level mode: once per refinement
# level per substep).  Each call acquires that level's grid-function
# pointers and geometry into LD[level].  Under time subcycling the
# particles are integrated exactly once per call-batch, on the finest-level
# call (rank 0), where the batch tracking + regrid decay live in the
# trigger logic of Geodesic_integrate.c; the step size is the elapsed
# cctk_time between firings (the finest level's dt).  A single-level run
# is one call and one integration per iteration -- the same behavior as the
# old unigrid mode.
#
# Multi-process (owner-computes): with Exact=no (multi_amr mode) the
# domain is partitioned among the ranks and each rank integrates the
# particles owned by its local patch; the step is integrated in
# coordinate-time chunks with a state exchange and an ownership recompute
# at each chunk boundary, and an MPI_Allgather keeps the replicated
# particle arrays bit-identical on all ranks (at most 4 ranks, a 2x2
# (y,z) decomposition with one patch per rank per level).  With Exact=yes
# (multi_exact mode) the analytic metric is valid everywhere, so rank 0
# integrates all particles and writes the dump.
#
# READS: the metric fields are fetched from the per-level grid in Exact=no
# mode; the dependencies are declared so that the schedule, PreSync and the
# mixed-error control know about them.
schedule geodesics_integrate at CCTK_POSTSTEP
{
  LANG: C
  READS: ADMBase::gxx ADMBase::gxy ADMBase::gxz ADMBase::gyy ADMBase::gyz ADMBase::gzz ADMBase::alp ADMBase::betax ADMBase::betay ADMBase::betaz
} "Integrate particle geodesic motion (u^mu renormalization, loss policy)"

# Storage follows the total particle count: the arrays are sized by
# particle_n_total, so random-only runs (particle_n = 0) need storage too.
if (particle_n_total)
{
  STORAGE:particle_arrays
}
