# interface.ccl for thorn Geodesic
# Licence : GPLv2+ (see COPYING)

implements: Geodesic

inherits: Grid
inherits: ADMBase

# Multi-patch aware: Geodesic tracks particles on whichever map (patch)
# of the multipath coordinate system owns them.  It asks the driver for
# the current map, the total map count, and the global<->local coordinate
# transforms (plus their Jacobians) of the Thornburg-style patch system.
USES FUNCTION MultiPatch_GetMap
USES FUNCTION MultiPatch_GetMaps
USES FUNCTION MultiPatch_GlobalToLocal
USES FUNCTION MultiPatch_LocalToGlobal

public:

# Per-particle evolved state.
#
# DISTRIB=CONSTANT: the complete arrays are replicated on every MPI
# rank.  The C code addresses particle 0 .. particle_n_total-1 locally
# on each process; multi-process runs distribute the particles over the
# ranks with the owner-computes scheme (see the README "Limitations"
# section).
#
# The arrays are checkpointable (no checkpoint="no" tag) so that the
# particle state survives a restart.
CCTK_REAL particle_arrays TYPE=ARRAY DIM=1 TIMELEVELS=1 SIZE=particle_n_total GHOSTSIZE=0 DISTRIB=CONSTANT
{
  particle_ttw    # accumulated proper time tau
  particle_tt     # coordinate time t
  particle_tx     # x
  particle_ty     # y
  particle_tz     # z
  particle_ttv    # u^t = dt/dtau
  particle_txv    # u^x = dx/dtau
  particle_tyv    # u^y = dy/dtau
  particle_tzv    # u^z = dz/dtau
} "Particle tracking arrays"
